# URL pubblico del sito: usato per canonical, hreflang, Open Graph e sitemap.
# Senza questa variabile si usa il valore di riserva in src/lib/site.ts
NEXT_PUBLIC_SITE_URL=https://svezia.italia-pratica.it

# Contribuzione volontaria.
# Serve un URL COMPLETO, non un handle: da un nome utente nudo non si puo
# sapere la piattaforma, e la variabile viene ignorata (ne blocco ne banner).
#
#   https://revolut.me/<handle>      link personale Revolut, gratis
#   https://buy.stripe.com/<id>      Stripe Payment Link
#   https://ko-fi.com/<handle>       Ko-fi
#   https://buymeacoffee.com/<h>     Buy Me a Coffee
#
# Vuota o non valida -> il bottone espresso non compare da nessuna parte.
NEXT_PUBLIC_SUPPORT_URL=https://revolut.me/iltuohandle


# La valuta e il prezzo di un espresso NON stanno qui: cambiano per lingua
# (corone sulla pagina svedese, euro su quella italiana e inglese) e vivono
# in SUPPORT_MONEY dentro src/lib/site.ts, accanto al commento che spiega
# perche. Vanno tenuti allineati alle valute che il conto Revolut possiede.
